<!DOCTYPE html>
<html lang="{{ site.lang }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
        {#
            Pagefind's stylesheet goes in a cascade layer above the site's
            element defaults and below everything else, so notes.css restyles
            search with plain selectors instead of out-ranking the specificity
            boosters Pagefind ships with. The build writes it pre-wrapped in
            that layer (see plugins/pagefind.js). This statement comes first
            so it fixes the layer order before either sheet is read.
        #}
        <style>@layer base, pagefind;</style>
        <link rel="stylesheet" href="/pagefind/pagefind-component-ui.layered.css">
        {%- include "head/css-inline.njk" %}
        {%- include "head/meta.njk" %}
        <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
        <!-- Minimal theme initialization to prevent flash -->
        <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const isDark = savedTheme ? savedTheme === 'dark' : systemPrefersDark;
            document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        })();
        </script>
    </head>
    <body>
        {%- include "partials/header.njk" %}
        <main class="main">
            {{ content | safe }}
        </main>
        {%- include "partials/footer.njk" %}
        {%- include "head/theme-toggle.njk" %}
        <script src="/assets/js/preview.js" type="module"></script>
    </body>
</html>
